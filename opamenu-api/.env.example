# Copie para .env antes de `docker compose up`
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Opcionais: se definidos, o emissor do token precisa usar os mesmos valores
JWT_ISSUER=
JWT_AUDIENCE=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Ligue (true) somente depois de vincular APP_GESTOR, APP_GARCOM, PDV_DESKTOP e CARDAPIO_DELIVERY aos planos
PLAN_ENFORCEMENT_ENABLED=false
