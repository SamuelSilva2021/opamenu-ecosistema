<UserControl x:Class="OpaMenu.Desktop.Views.TableDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <materialDesign:Card Style="{StaticResource OpaMenuCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,16">
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Content="Voltar"
                        Command="{Binding BackToTablesCommand}"
                        Margin="0,0,12,0" />
                <TextBlock Text="{Binding SelectedTableDetails.Name, StringFormat='Mesa: {0}'}"
                           FontSize="{StaticResource OpaMenuFontSizeH4}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Style="{StaticResource OpaMenuCard}" Grid.Column="0" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Comandas" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding SelectedTableTabs}"
                                     SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,8">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                            <DockPanel>
                                                <TextBlock Text="{Binding StatusText}" Opacity="0.8"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat={}{0:C}}" FontWeight="SemiBold"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource OpaMenuCard}" Grid.Column="1" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedTab.Name, StringFormat='Consumo - {0}'}" FontWeight="SemiBold"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedTabTotal, StringFormat={}{0:C}}" FontWeight="Bold"/>
                            </DockPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedTab.Orders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource OpaMenuBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding OrderNumber, StringFormat='Pedido #{0}'}" FontWeight="Bold"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat={}{0:C}}" FontWeight="SemiBold"/>
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Quantity}" Width="28" FontWeight="SemiBold"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding ProductName}" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat={}{0:C}}" FontWeight="SemiBold"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource OpaMenuCard}" Grid.Column="2">
                        <StackPanel>
                            <TextBlock Text="Fechamento" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding SelectedTabTotal, StringFormat='Total: {0:C}'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource OpaMenuPrimaryBrush}" Margin="0,0,0,16"/>

                            <Button Style="{StaticResource OpaMenuOutlineButton}"
                                    Content="IMPRIMIR CONTA"
                                    Command="{Binding PrintSelectedTabCommand}"
                                    Margin="0,0,0,12"/>

                            <Button Style="{StaticResource OpaMenuPrimaryButton}"
                                    Content="FECHAR COMANDA"
                                    Command="{Binding OpenTabCheckoutModalCommand}"
                                    IsEnabled="{Binding CanCheckoutSelectedTab}"
                                    Margin="0,0,0,12"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </Grid>
        </Grid>
        </materialDesign:Card>
</UserControl>
