<Window x:Class="OpaMenu.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:OpaMenu.Desktop.Views"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        TextElement.Foreground="{DynamicResource OpaMenuTextPrimaryBrush}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="{StaticResource OpaMenuFontSizeBase}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource OpaMenuBackgroundBrush}"
        FontFamily="{DynamicResource OpaMenuBaseFontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="OpaMenuTopNavButtonBase" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="20" />
            <Setter Property="Height" Value="36" />
        </Style>
    </Window.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadStorefrontCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <materialDesign:DialogHost DialogTheme="Inherit" IsOpen="{Binding IsAnyModalOpen}">
        <materialDesign:DialogHost.DialogContent>
            <Grid Margin="16">
                <!-- Modal de Identificação do Cliente -->
                <Border Width="400" Background="{StaticResource OpaMenuSurfaceBrush}" CornerRadius="12" Padding="24"
                        Visibility="{Binding IsCustomerModalOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Identificação do Cliente" FontSize="{StaticResource OpaMenuFontSizeH4}" FontWeight="Bold" Margin="0,0,0,24"/>

                        <TextBox Style="{StaticResource OpaMenuTextBox}" 
                                 materialDesign:HintAssist.Hint="Número da Mesa" 
                                 Text="{Binding TableNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16"/>

                        <TextBox Style="{StaticResource OpaMenuTextBox}" 
                                 materialDesign:HintAssist.Hint="Nome do Cliente (Para Chamar)" 
                                 Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16"/>

                        <TextBox Style="{StaticResource OpaMenuTextBox}" 
                                 materialDesign:HintAssist.Hint="CPF na Nota (Opcional)" 
                                 Text="{Binding CustomerDocument, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16"/>

                        <TextBox Style="{StaticResource OpaMenuTextBox}" 
                                 materialDesign:HintAssist.Hint="Observações do Pedido (Opcional)" 
                                 Text="{Binding OrderObservation, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,24" AcceptsReturn="True" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                    Content="CANCELAR" 
                                    Command="{Binding CloseModalsCommand}" 
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource OpaMenuPrimaryButton}" 
                                    Content="SALVAR" 
                                    Command="{Binding CloseModalsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Modal de Seleção de Adicionais -->
                <Border Width="500" Background="{StaticResource OpaMenuSurfaceBrush}" CornerRadius="12" Padding="24"
                        Visibility="{Binding IsAddonSelectionModalOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ProductToConfigure.Name, StringFormat='Personalizar: {0}'}" FontSize="{StaticResource OpaMenuFontSizeH4}" FontWeight="Bold" Margin="0,0,0,24"/>

                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AddonGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Description}" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Options}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBox Style="{StaticResource OpaMenuTextBox}" 
                                 materialDesign:HintAssist.Hint="Observação do Item" 
                                 Text="{Binding ItemNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,16,0,16"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Content="CANCELAR" Command="{Binding CloseModalsCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource OpaMenuPrimaryButton}" Content="ADICIONAR" Command="{Binding AddToCartFromModalCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Modal de Checkout -->
                <Border Width="500" Background="{StaticResource OpaMenuSurfaceBrush}" CornerRadius="12" Padding="24"
                        Visibility="{Binding IsCheckoutModalOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Finalizar Venda" FontSize="{StaticResource OpaMenuFontSizeH4}" FontWeight="Bold" Margin="0,0,0,24"/>
                        
                        <TextBlock Text="{Binding CartTotal, StringFormat='Total a Pagar: {0:C}'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource OpaMenuPrimaryBrush}" Margin="0,0,0,16"/>

                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                            <ItemsControl ItemsSource="{Binding Payments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding DataContext.PaymentMethodOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Method, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                      materialDesign:HintAssist.Hint="Forma"
                                                      Margin="0,0,8,0" />

                                            <TextBox Grid.Column="1"
                                                     Style="{StaticResource OpaMenuTextBox}"
                                                     materialDesign:HintAssist.Hint="Valor (R$)"
                                                     Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,8,0" />

                                            <Button Grid.Column="2"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Remover">
                                                <materialDesign:PackIcon Kind="Close" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Style="{StaticResource OpaMenuOutlineButton}"
                                Content="Adicionar pagamento"
                                Command="{Binding AddPaymentCommand}"
                                Margin="0,0,0,16"/>

                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="{Binding TotalPaid, StringFormat='Total pago: {0:C}'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding RemainingAmount, StringFormat='Restante: {0:C}'}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ChangeAmount, StringFormat='Troco: {0:C}'}" Foreground="#4CAF50" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Content="CANCELAR" Command="{Binding CloseModalsCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource OpaMenuPrimaryButton}" Content="CONFIRMAR PAGAMENTO" Command="{Binding ConfirmPaymentCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Width="480" Background="{StaticResource OpaMenuSurfaceBrush}" CornerRadius="12" Padding="24"
                        Visibility="{Binding IsTabCheckoutModalOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTab.Name, StringFormat='Fechar {0}'}" FontSize="{StaticResource OpaMenuFontSizeH4}" FontWeight="Bold" Margin="0,0,0,16"/>

                        <TextBlock Text="{Binding SelectedTabTotal, StringFormat='Total da comanda: {0:C}'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource OpaMenuPrimaryBrush}" Margin="0,0,0,16"/>

                        <ComboBox ItemsSource="{Binding TabPaymentMethodOptions}"
                                  SelectedItem="{Binding SelectedTabPaymentMethod, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  materialDesign:HintAssist.Hint="Forma de pagamento"
                                  Margin="0,0,0,24" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Content="CANCELAR" Command="{Binding CloseModalsCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource OpaMenuPrimaryButton}" Content="CONFIRMAR" Command="{Binding ConfirmTabCheckoutCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Width="420" Background="{StaticResource OpaMenuSurfaceBrush}" CornerRadius="12" Padding="24"
                        Visibility="{Binding IsCashModalOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding CashModalTitle}" FontSize="{StaticResource OpaMenuFontSizeH4}" FontWeight="Bold" Margin="0,0,0,24"/>

                        <StackPanel Visibility="{Binding IsOpeningCashShift, Converter={StaticResource BoolToVis}}">
                            <TextBox Style="{StaticResource OpaMenuTextBox}"
                                     materialDesign:HintAssist.Hint="Saldo inicial (R$)"
                                     Text="{Binding OpeningCashBalance, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,16"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsClosingCashShift, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Resumo deste caixa" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding ClosingSalesByPaymentMethod}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="False" Margin="0,2">
                                            <TextBlock Text="{Binding PaymentMethodName}" Width="160"/>
                                            <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:C}}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Vendas:" Width="160"/>
                                <TextBlock Text="{Binding ClosingTotalSales, StringFormat={}{0:C}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Entradas:" Width="160"/>
                                <TextBlock Text="{Binding ClosingTotalInflows, StringFormat={}{0:C}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Saídas:" Width="160"/>
                                <TextBlock Text="{Binding ClosingTotalOutflows, StringFormat={}{0:C}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Saldo esperado:" Width="160"/>
                                <TextBlock Text="{Binding ExpectedCashBalance, StringFormat={}{0:C}}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <TextBox Style="{StaticResource OpaMenuTextBox}"
                                     materialDesign:HintAssist.Hint="Saldo de fechamento (R$)"
                                     Text="{Binding ClosingCashBalance, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Diferença:" Width="160"/>
                                <TextBlock Text="{Binding ClosingDiscrepancy, StringFormat={}{0:C}}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <TextBox Style="{StaticResource OpaMenuTextBox}"
                                     materialDesign:HintAssist.Hint="Justificativa (obrigatória se houver diferença)"
                                     Text="{Binding ClosingDiscrepancyJustification, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding HasClosingDiscrepancy, Converter={StaticResource BoolToVis}}"
                                     Margin="0,0,0,16"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsCashMovementModal, Converter={StaticResource BoolToVis}}">
                            <TextBox Style="{StaticResource OpaMenuTextBox}"
                                     materialDesign:HintAssist.Hint="Valor (R$)"
                                     Text="{Binding CashMovementAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,16"/>
                            <TextBox Style="{StaticResource OpaMenuTextBox}"
                                     materialDesign:HintAssist.Hint="Descrição"
                                     Text="{Binding CashMovementDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,16"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Content="CANCELAR"
                                    Command="{Binding CloseModalsCommand}"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource OpaMenuPrimaryButton}"
                                    Content="CONFIRMAR"
                                    Command="{Binding ConfirmCashShiftCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </materialDesign:DialogHost.DialogContent>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Top Bar / Cabeçalho -->
            <materialDesign:ColorZone Background="{StaticResource OpaMenuPrimaryBrush}" Foreground="White" Padding="16" Grid.Row="0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Food" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="18" FontWeight="Medium" />

                        <Button Content="PDV" Command="{Binding NavigateToPdvCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OpaMenuTopNavButtonBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPdvSection}" Value="True">
                                            <Setter Property="Background" Value="#33FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Mesas" Command="{Binding NavigateToTablesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OpaMenuTopNavButtonBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTablesSection}" Value="True">
                                            <Setter Property="Background" Value="#33FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CashShiftStatusText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding OperatorName}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Content="Abrir Caixa"
                                Command="{Binding OpenCashShiftModalCommand}"
                                Visibility="{Binding IsCashShiftClosed, Converter={StaticResource BoolToVis}}"
                                Foreground="White"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Content="Fechar Caixa"
                                Command="{Binding OpenCloseCashShiftModalCommand}"
                                Visibility="{Binding IsCashShiftOpen, Converter={StaticResource BoolToVis}}"
                                Foreground="White"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Content="Suprimento"
                                Command="{Binding OpenCashInboundMovementModalCommand}"
                                Visibility="{Binding IsCashShiftOpen, Converter={StaticResource BoolToVis}}"
                                Foreground="White"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Content="Sangria"
                                Command="{Binding OpenCashOutboundMovementModalCommand}"
                                Visibility="{Binding IsCashShiftOpen, Converter={StaticResource BoolToVis}}"
                                Foreground="White"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Atualizar Cardápio" Foreground="White" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="CloudSync" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Sair" Foreground="White">
                            <materialDesign:PackIcon Kind="Logout" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </materialDesign:ColorZone>

            <!-- Corpo Principal -->
            <Grid Grid.Row="1" Margin="16">
                <Grid Visibility="{Binding IsPdvSection, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="350" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Style="{StaticResource OpaMenuCard}" Grid.Column="0" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Categorias" FontSize="{StaticResource OpaMenuFontSizeH4}" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        
                            <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectionChanged">
                                        <i:InvokeCommandAction Command="{Binding DataContext.FilterProductsByCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,8">
                                            <materialDesign:PackIcon Kind="FolderOutline" Width="24" Height="24" Margin="0,0,12,0" Foreground="{StaticResource OpaMenuPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource OpaMenuFontSizeLarge}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource OpaMenuCard}" Grid.Column="1" Margin="0,0,16,0" Background="{StaticResource OpaMenuSurfaceBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="Lanches" FontSize="{StaticResource OpaMenuFontSizeH4}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Width="250" HorizontalAlignment="Right" DockPanel.Dock="Right" 
                                         Style="{StaticResource OpaMenuTextBox}" 
                                         materialDesign:HintAssist.Hint="Buscar Produto..." 
                                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                         materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                         Padding="12,8"/>
                            </DockPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Products}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                                    Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="0" Margin="4" Width="160" Height="140"
                                                    Background="White" BorderBrush="{StaticResource OpaMenuBorderBrush}" BorderThickness="1"
                                                    materialDesign:ButtonAssist.CornerRadius="12">
                                                <Grid Width="160" Height="140">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Background="#EEEEEE" CornerRadius="12,12,0,0">
                                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" Margin="0" />
                                                    </Border>
                                                
                                                    <StackPanel Grid.Row="1" Margin="8">
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="Medium" MaxHeight="40"/>
                                                        <TextBlock Text="{Binding Price, StringFormat=C}" Foreground="{StaticResource OpaMenuPrimaryBrush}" FontWeight="Bold" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource OpaMenuCard}" Grid.Column="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="Ticket Atual" FontSize="{StaticResource OpaMenuFontSizeH4}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" HorizontalAlignment="Right"
                                        Command="{Binding ClearCartCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TrashCan" Margin="0,0,4,0"/>
                                        <TextBlock Text="Limpar"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Style="{StaticResource OpaMenuOutlineButton}" 
                                        Margin="0,0,8,0" Height="40" Padding="12,0"
                                        Command="{Binding OpenCustomerModalCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Mesa "/>
                                        <TextBlock Text="{Binding TableNumber}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource OpaMenuOutlineButton}" 
                                        Height="40" Padding="12,0"
                                        Command="{Binding OpenCustomerModalCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Account" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CustomerName}" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CartItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                            
                                                <Border Grid.Column="0" Background="{StaticResource OpaMenuSurfaceBrush}" CornerRadius="4" Width="32" Height="32" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Quantity}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProductName}" FontWeight="Medium" TextWrapping="Wrap"/>
                                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" Padding="0" Height="20" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="Remover item" FontSize="11"/>
                                                    </Button>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat=C}" FontWeight="Bold" VerticalAlignment="Top"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                                <Separator Margin="0,0,0,16" Background="{StaticResource OpaMenuBorderBrush}"/>
                            
                                <DockPanel Margin="0,0,0,16">
                                    <TextBlock Text="Total:" FontSize="{StaticResource OpaMenuFontSizeH3}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CartTotal, StringFormat=C}" FontSize="{StaticResource OpaMenuFontSizeH3}" FontWeight="Bold" Foreground="{StaticResource OpaMenuPrimaryBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                </DockPanel>
                            
                                <Button Style="{StaticResource OpaMenuPrimaryButton}" Content="COBRAR E ENVIAR" FontSize="{StaticResource OpaMenuFontSizeLarge}" Command="{Binding OpenCheckoutModalCommand}"/>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <Grid Visibility="{Binding IsTablesListSection, Converter={StaticResource BoolToVis}}">
                    <materialDesign:Card Style="{StaticResource OpaMenuCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TableChair" Width="24" Height="24" Margin="0,0,8,0" Foreground="{StaticResource OpaMenuPrimaryBrush}"/>
                                    <TextBlock Text="Mesas" FontSize="{StaticResource OpaMenuFontSizeH4}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="Atualizar"
                                        Command="{Binding LoadTablesCommand}" />
                            </DockPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Tables}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                    Command="{Binding DataContext.OpenTableDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="0"
                                                    Margin="6"
                                                    Background="Transparent"
                                                    Height="Auto"
                                                    MinHeight="0"
                                                    VerticalContentAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch">
                                                <Border Width="180" Height="110" CornerRadius="12" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource OpaMenuSurfaceBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource OpaMenuBorderBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Livre">
                                                                    <Setter Property="Background" Value="#D1FAE5" />
                                                                    <Setter Property="BorderBrush" Value="#34D399" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Ocupada">
                                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                                    <Setter Property="BorderBrush" Value="#F87171" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Aguardando conta">
                                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                                    <Setter Property="BorderBrush" Value="#F59E0B" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid Margin="14">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="Bold"/>
                                                        <TextBlock Grid.Row="1" Text="{Binding Status}" VerticalAlignment="Bottom" Opacity="0.85" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <Grid Visibility="{Binding IsTableDetailsSection, Converter={StaticResource BoolToVis}}">
                    <materialDesign:Card Style="{StaticResource OpaMenuCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Margin="0,0,0,16">
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="Voltar"
                                        Command="{Binding BackToTablesCommand}"
                                        Margin="0,0,12,0" />
                                <TextBlock Text="{Binding SelectedTableDetails.Name, StringFormat='Mesa: {0}'}"
                                           FontSize="{StaticResource OpaMenuFontSizeH4}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="320"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:Card Style="{StaticResource OpaMenuCard}" Grid.Column="0" Margin="0,0,16,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Comandas" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <ListBox Grid.Row="1"
                                                 ItemsSource="{Binding SelectedTableTabs}"
                                                 SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                                 Background="Transparent"
                                                 BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding StatusText}" Opacity="0.8"/>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat={}{0:C}}" FontWeight="SemiBold"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </materialDesign:Card>

                                <materialDesign:Card Style="{StaticResource OpaMenuCard}" Grid.Column="1" Margin="0,0,16,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding SelectedTab.Name, StringFormat='Consumo - {0}'}" FontWeight="SemiBold"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedTabTotal, StringFormat={}{0:C}}" FontWeight="Bold"/>
                                        </DockPanel>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SelectedTab.Orders}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource OpaMenuBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                                            <StackPanel>
                                                                <DockPanel Margin="0,0,0,8">
                                                                    <TextBlock Text="{Binding OrderNumber, StringFormat='Pedido #{0}'}" FontWeight="Bold"/>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat={}{0:C}}" FontWeight="SemiBold"/>
                                                                </DockPanel>
                                                                <ItemsControl ItemsSource="{Binding Items}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" Text="{Binding Quantity}" Width="28" FontWeight="SemiBold"/>
                                                                                <TextBlock Grid.Column="1" Text="{Binding ProductName}" TextWrapping="Wrap" />
                                                                                <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat={}{0:C}}" FontWeight="SemiBold"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </materialDesign:Card>

                                <materialDesign:Card Style="{StaticResource OpaMenuCard}" Grid.Column="2">
                                    <StackPanel>
                                        <TextBlock Text="Fechamento" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <TextBlock Text="{Binding SelectedTabTotal, StringFormat='Total: {0:C}'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource OpaMenuPrimaryBrush}" Margin="0,0,0,16"/>

                                        <Button Style="{StaticResource OpaMenuPrimaryButton}"
                                                Content="FECHAR COMANDA"
                                                Command="{Binding OpenTabCheckoutModalCommand}"
                                                IsEnabled="{Binding CanCheckoutSelectedTab}"
                                                Margin="0,0,0,12"/>
                                    </StackPanel>
                                </materialDesign:Card>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
