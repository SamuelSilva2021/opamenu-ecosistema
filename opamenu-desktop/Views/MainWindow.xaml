<Window x:Class="OpaMenu.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:OpaMenu.Desktop.Views"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        TextElement.Foreground="{DynamicResource OpaMenuTextPrimaryBrush}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="{StaticResource OpaMenuFontSizeBase}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource OpaMenuBackgroundBrush}"
        FontFamily="{DynamicResource OpaMenuBaseFontFamily}">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadStorefrontCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <materialDesign:DialogHost DialogTheme="Inherit">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Top Bar / Cabeçalho -->
            <materialDesign:ColorZone Background="{StaticResource OpaMenuPrimaryBrush}" Foreground="White" Padding="16" Grid.Row="0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Food" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="18" FontWeight="Medium" />
                    </StackPanel>
                    
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding OperatorName}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Atualizar Cardápio" Foreground="White" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="CloudSync" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Sair" Foreground="White">
                            <materialDesign:PackIcon Kind="Logout" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </materialDesign:ColorZone>

            <!-- Corpo Principal -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" /> <!-- Barra de Categorias -->
                    <ColumnDefinition Width="*" />   <!-- Grid de Produtos -->
                    <ColumnDefinition Width="350" /> <!-- Ticket / Carrinho -->
                </Grid.ColumnDefinitions>

                <!-- 2. Categorias (Sidebar Esquerda) -->
                <materialDesign:Card Style="{StaticResource OpaMenuCard}" Grid.Column="0" Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Categorias" FontSize="{StaticResource OpaMenuFontSizeH4}" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        
                        <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding DataContext.FilterProductsByCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <!-- Note: Real categories don't have 'Icon' string in DTO right now, using a fallback -->
                                        <materialDesign:PackIcon Kind="FolderOutline" Width="24" Height="24" Margin="0,0,12,0" Foreground="{StaticResource OpaMenuPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource OpaMenuFontSizeLarge}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </materialDesign:Card>

                <!-- 3. Grid de Produtos (Centro) -->
                <materialDesign:Card Style="{StaticResource OpaMenuCard}" Grid.Column="1" Margin="0,0,16,0" Background="{StaticResource OpaMenuSurfaceBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Busca e Título -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Lanches" FontSize="{StaticResource OpaMenuFontSizeH4}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBox Width="250" HorizontalAlignment="Right" DockPanel.Dock="Right" 
                                     Style="{StaticResource OpaMenuTextBox}" 
                                     materialDesign:HintAssist.Hint="Buscar Produto..." 
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                     Padding="12,8"/>
                        </DockPanel>

                        <!-- Lista de Produtos -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Products}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Padding="0" Margin="4" Width="160" Height="140"
                                                Background="White" BorderBrush="{StaticResource OpaMenuBorderBrush}" BorderThickness="1"
                                                materialDesign:ButtonAssist.CornerRadius="12">
                                            <Grid Width="160" Height="140">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <!-- "Foto" do Produto -->
                                                <Border Grid.Row="0" Background="#EEEEEE" CornerRadius="12,12,0,0">
                                                    <!-- A imagem só vai renderizar se ImageUrl tiver um valor válido -->
                                                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" Margin="0" />
                                                </Border>
                                                
                                                <StackPanel Grid.Row="1" Margin="8">
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="Medium" MaxHeight="40"/>
                                                    <TextBlock Text="{Binding Price, StringFormat=C}" Foreground="{StaticResource OpaMenuPrimaryBrush}" FontWeight="Bold" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>

                <!-- 4. Ticket / Carrinho (Sidebar Direita) -->
                <materialDesign:Card Style="{StaticResource OpaMenuCard}" Grid.Column="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Ticket Atual" FontSize="{StaticResource OpaMenuFontSizeH4}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" HorizontalAlignment="Right"
                                    Command="{Binding ClearCartCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TrashCan" Margin="0,0,4,0"/>
                                    <TextBlock Text="Limpar"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Style="{StaticResource OpaMenuOutlineButton}" Content="Mesa 05" Margin="0,0,8,0" Height="40" Padding="12,0"/>
                            <Button Style="{StaticResource OpaMenuOutlineButton}" Content="João (Cliente)" Height="40" Padding="12,0"/>
                        </StackPanel>

                        <!-- Itens do Carrinho -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CartItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Quantidade -->
                                            <Border Grid.Column="0" Background="{StaticResource OpaMenuSurfaceBrush}" CornerRadius="4" Width="32" Height="32" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Quantity}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Nome e Ações -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" FontWeight="Medium" TextWrapping="Wrap"/>
                                                <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" Padding="0" Height="20" HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="Remover item" FontSize="11"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Preço Total do Item -->
                                            <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat=C}" FontWeight="Bold" VerticalAlignment="Top"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Rodapé do Carrinho (Total e Botão de Pagar) -->
                        <StackPanel Grid.Row="3" Margin="0,16,0,0">
                            <Separator Margin="0,0,0,16" Background="{StaticResource OpaMenuBorderBrush}"/>
                            
                            <DockPanel Margin="0,0,0,16">
                                <TextBlock Text="Total:" FontSize="{StaticResource OpaMenuFontSizeH3}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CartTotal, StringFormat=C}" FontSize="{StaticResource OpaMenuFontSizeH3}" FontWeight="Bold" Foreground="{StaticResource OpaMenuPrimaryBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                            </DockPanel>
                            
                            <Button Style="{StaticResource OpaMenuPrimaryButton}" Content="COBRAR E ENVIAR" FontSize="{StaticResource OpaMenuFontSizeLarge}"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>