<UserControl x:Class="OpaMenu.Desktop.Views.PdvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <materialDesign:Card Style="{StaticResource OpaMenuCard}" Grid.Column="0" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Categorias" FontSize="{StaticResource OpaMenuFontSizeH4}" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,8">
                                <materialDesign:PackIcon Kind="FolderOutline" Width="24" Height="24" Margin="0,0,12,0" Foreground="{StaticResource OpaMenuPrimaryBrush}"/>
                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource OpaMenuFontSizeLarge}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Style="{StaticResource OpaMenuCard}" Grid.Column="1" Margin="0,0,16,0" Background="{StaticResource OpaMenuSurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="{Binding CurrentCategoryTitle}" FontSize="{StaticResource OpaMenuFontSizeH4}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Width="250" HorizontalAlignment="Right" DockPanel.Dock="Right" 
                             Style="{StaticResource OpaMenuTextBox}" 
                             materialDesign:HintAssist.Hint="Buscar Produto..." 
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                             Padding="12,8"/>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Padding="0" Margin="4" Width="180" Height="190"
                                        Background="White" BorderBrush="{StaticResource OpaMenuBorderBrush}" BorderThickness="1"
                                        materialDesign:ButtonAssist.CornerRadius="12">
                                    <Grid Width="180" Height="190">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="110"/>
                                            <RowDefinition Height="52"/>
                                            <RowDefinition Height="28"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#EEEEEE" CornerRadius="12,12,0,0" ClipToBounds="True">
                                            <Image Source="{Binding ImageUrl}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Margin="10,8,10,0"
                                                   Text="{Binding Name}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   MaxHeight="44" />

                                        <TextBlock Grid.Row="2"
                                                   Margin="10,0,10,8"
                                                   Text="{Binding Price, StringFormat=C}"
                                                   Foreground="{StaticResource OpaMenuPrimaryBrush}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Bottom" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Style="{StaticResource OpaMenuCard}" Grid.Column="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Ticket Atual" FontSize="{StaticResource OpaMenuFontSizeH4}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" HorizontalAlignment="Right"
                            Command="{Binding ClearCartCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrashCan" Margin="0,0,4,0"/>
                            <TextBlock Text="Limpar"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Style="{StaticResource OpaMenuOutlineButton}" 
                            Margin="0,0,8,0" Height="40" Padding="12,0"
                            Command="{Binding OpenCustomerModalCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mesa "/>
                            <TextBlock Text="{Binding TableNumber}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OpaMenuOutlineButton}" 
                            Height="40" Padding="12,0"
                            Command="{Binding OpenCustomerModalCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Account" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CustomerName}" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CartItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource OpaMenuSurfaceBrush}" CornerRadius="4" Width="32" Height="32" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Quantity}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="Medium" TextWrapping="Wrap"/>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" Padding="0" Height="20" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="Remover item" FontSize="11"/>
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat=C}" FontWeight="Bold" VerticalAlignment="Top"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <Separator Margin="0,0,0,16" Background="{StaticResource OpaMenuBorderBrush}"/>

                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="Total:" FontSize="{StaticResource OpaMenuFontSizeH3}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CartTotal, StringFormat=C}" FontSize="{StaticResource OpaMenuFontSizeH3}" FontWeight="Bold" Foreground="{StaticResource OpaMenuPrimaryBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <Button Style="{StaticResource OpaMenuPrimaryButton}" Content="COBRAR E ENVIAR" FontSize="{StaticResource OpaMenuFontSizeLarge}" Command="{Binding OpenCheckoutModalCommand}"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
