<Window x:Class="OpaMenu.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="OpaMenu - Login" Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        TextElement.Foreground="{DynamicResource OpaMenuTextPrimaryBrush}"
        FontFamily="{DynamicResource OpaMenuBaseFontFamily}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="{StaticResource OpaMenuBackgroundBrush}" CornerRadius="16" Margin="16">
        <Border.Effect>
            <!-- Sombra suave para a janela sem bordas -->
            <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Color="#20000000"/>
        </Border.Effect>
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Botão Fechar -->
            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Style="{StaticResource MaterialDesignToolButton}" 
                    Click="BtnClose_Click" Margin="-16,-16,-16,0" Foreground="{StaticResource OpaMenuTextSecondaryBrush}">
                <materialDesign:PackIcon Kind="Close"/>
            </Button>

            <!-- Logo / Título -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,16,0,32">
                <materialDesign:PackIcon Kind="FoodForkDrink" Width="64" Height="64" Foreground="{StaticResource OpaMenuPrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="OpaMenu" FontSize="{StaticResource OpaMenuFontSizeH3}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="Gestor de Caixa" FontSize="{StaticResource OpaMenuFontSizeBase}" Foreground="{StaticResource OpaMenuTextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Formulário -->
            <TextBox Grid.Row="1" Style="{StaticResource OpaMenuTextBox}" 
                     materialDesign:HintAssist.Hint="E-mail de acesso" 
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,16"/>

            <!-- O PasswordBox é passado como parâmetro no Command no botão -->
            <PasswordBox Grid.Row="2" x:Name="txtPassword" Style="{StaticResource OpaMenuPasswordBox}" 
                         materialDesign:HintAssist.Hint="Senha" 
                         Margin="0,0,0,8"/>

            <!-- Mensagem de Erro (Fica invisível caso não tenha erro) -->
            <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="Red" 
                       HorizontalAlignment="Center" Margin="0,0,0,16" TextWrapping="Wrap" TextAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Barra de Carregamento -->
            <ProgressBar Grid.Row="4" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                         Value="0" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Botão Entrar -->
            <Button Grid.Row="5" Style="{StaticResource OpaMenuPrimaryButton}" 
                    Command="{Binding LoginCommand}" 
                    CommandParameter="{Binding ElementName=txtPassword}"
                    Content="ENTRAR" />
        </Grid>
    </Border>
</Window>