<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- OpaMenu Typography: Poppins -->
    <!-- The # is used to reference the font name defined inside the TTF file -->
    <FontFamily x:Key="OpaMenuBaseFontFamily">pack://application:,,,/Resources/Fonts/#Poppins</FontFamily>

    <!-- Font Sizes -->
    <sys:Double x:Key="OpaMenuFontSizeSmall" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="OpaMenuFontSizeBase" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="OpaMenuFontSizeLarge" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="OpaMenuFontSizeH4" xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
    <sys:Double x:Key="OpaMenuFontSizeH3" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    <sys:Double x:Key="OpaMenuFontSizeH2" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
    <sys:Double x:Key="OpaMenuFontSizeH1" xmlns:sys="clr-namespace:System;assembly=mscorlib">40</sys:Double>

</ResourceDictionary>