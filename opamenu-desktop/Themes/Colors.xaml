<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Opamenu Brand Colors -->
    <Color x:Key="OpamenuPrimaryColor">#F8772E</Color>
    <Color x:Key="OpamenuPrimaryLightColor">#FFA85D</Color>
    <Color x:Key="OpamenuPrimaryDarkColor">#C04700</Color>
    <Color x:Key="OpamenuSecondaryColor">#1A1A1A</Color>
    
    <!-- Backgrounds & Surfaces -->
    <Color x:Key="OpamenuBackgroundColor">#FFFFFF</Color>
    <Color x:Key="OpamenuSurfaceColor">#FAFAFA</Color>
    <Color x:Key="OpamenuBorderColor">#E0E0E0</Color>

    <!-- Text Colors -->
    <Color x:Key="OpamenuTextPrimaryColor">#1A1A1A</Color>
    <Color x:Key="OpamenuTextSecondaryColor">#757575</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="OpamenuPrimaryBrush" Color="{StaticResource OpamenuPrimaryColor}" />
    <SolidColorBrush x:Key="OpamenuPrimaryLightBrush" Color="{StaticResource OpamenuPrimaryLightColor}" />
    <SolidColorBrush x:Key="OpamenuPrimaryDarkBrush" Color="{StaticResource OpamenuPrimaryDarkColor}" />
    <SolidColorBrush x:Key="OpamenuSecondaryBrush" Color="{StaticResource OpamenuSecondaryColor}" />
    <SolidColorBrush x:Key="OpamenuBackgroundBrush" Color="{StaticResource OpamenuBackgroundColor}" />
    <SolidColorBrush x:Key="OpamenuSurfaceBrush" Color="{StaticResource OpamenuSurfaceColor}" />
    <SolidColorBrush x:Key="OpamenuBorderBrush" Color="{StaticResource OpamenuBorderColor}" />
    <SolidColorBrush x:Key="OpamenuTextPrimaryBrush" Color="{StaticResource OpamenuTextPrimaryColor}" />
    <SolidColorBrush x:Key="OpamenuTextSecondaryBrush" Color="{StaticResource OpamenuTextSecondaryColor}" />

    <!-- Material Design Overrides -->
    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="{StaticResource OpamenuPrimaryLightColor}" />
    <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{StaticResource OpamenuPrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="{StaticResource OpamenuPrimaryDarkColor}" />
    <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="SecondaryHueLightBrush" Color="#4D4D4D" />
    <SolidColorBrush x:Key="SecondaryHueLightForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="{StaticResource OpamenuSecondaryColor}" />
    <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryHueDarkBrush" Color="#000000" />
    <SolidColorBrush x:Key="SecondaryHueDarkForegroundBrush" Color="#FFFFFF" />

</ResourceDictionary>