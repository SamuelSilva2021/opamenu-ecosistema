<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Primary Button Style -->
    <Style x:Key="OpaMenuPrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{StaticResource OpaMenuPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpaMenuPrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="56" />
    </Style>

    <!-- Outline Button Style -->
    <Style x:Key="OpaMenuOutlineButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="BorderBrush" Value="{StaticResource OpaMenuBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpaMenuTextPrimaryBrush}" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Height" Value="56" />
    </Style>

    <!-- Custom TextBox (Inputs) Style -->
    <Style x:Key="OpaMenuTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="Background" Value="{StaticResource OpaMenuSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpaMenuBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpaMenuTextPrimaryBrush}" />
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="materialDesign:HintAssist.Foreground" Value="{StaticResource OpaMenuTextSecondaryBrush}" />
    </Style>

    <!-- Custom PasswordBox Style -->
    <Style x:Key="OpaMenuPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
        <Setter Property="Background" Value="{StaticResource OpaMenuSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpaMenuBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpaMenuTextPrimaryBrush}" />
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="materialDesign:HintAssist.Foreground" Value="{StaticResource OpaMenuTextSecondaryBrush}" />
    </Style>

    <!-- Default Card Style -->
    <Style x:Key="OpaMenuCard" TargetType="materialDesign:Card">
        <Setter Property="Background" Value="{StaticResource OpaMenuBackgroundBrush}" />
        <Setter Property="materialDesign:ThemeAssist.Theme" Value="Light" />
        <Setter Property="UniformCornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource OpaMenuBorderBrush}" />
    </Style>

    <DataTemplate x:Key="OpaMenuProductTileTemplate">
        <Button Style="{StaticResource MaterialDesignFlatButton}" 
                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"
                Padding="0" Margin="4" Width="180" Height="190"
                Background="White" BorderBrush="{StaticResource OpaMenuBorderBrush}" BorderThickness="1"
                materialDesign:ButtonAssist.CornerRadius="12">
            <Grid Width="180" Height="190">
                <Grid.RowDefinitions>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#EEEEEE" CornerRadius="12,12,0,0" ClipToBounds="True">
                    <Image Source="{Binding ImageUrl}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>

                <TextBlock Grid.Row="1"
                           Margin="10,8,10,0"
                           Text="{Binding Name}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           FontSize="13"
                           MaxHeight="44" />

                <TextBlock Grid.Row="2"
                           Margin="10,0,10,8"
                           Text="{Binding Price, StringFormat=C}"
                           Foreground="{StaticResource OpaMenuPrimaryBrush}"
                           FontWeight="Bold"
                           VerticalAlignment="Bottom" />
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="OpaMenuTableTileTemplate">
        <Button Style="{StaticResource MaterialDesignFlatButton}"
                Command="{Binding DataContext.OpenTableDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"
                Padding="0"
                Margin="6"
                Background="Transparent"
                Height="Auto"
                MinHeight="0"
                VerticalContentAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
            <Border Width="180" Height="110" CornerRadius="12" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource OpaMenuSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource OpaMenuBorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Livre">
                                <Setter Property="Background" Value="#D1FAE5" />
                                <Setter Property="BorderBrush" Value="#34D399" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Ocupada">
                                <Setter Property="Background" Value="#FEE2E2" />
                                <Setter Property="BorderBrush" Value="#F87171" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Aguardando conta">
                                <Setter Property="Background" Value="#FEF3C7" />
                                <Setter Property="BorderBrush" Value="#F59E0B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Text="{Binding Status}" VerticalAlignment="Bottom" Opacity="0.85" />
                </Grid>
            </Border>
        </Button>
    </DataTemplate>

</ResourceDictionary>
